<%= form_for todo_list do |todo_list_form| %>

  <div class="field">
   <%= todo_list_form.label :description %> <br/>
   <%= todo_list_form.text_field :description %> <br/>
  </div>

  <div class="field">
    <%= todo_list_form.label :notification %>
    <%= todo_list_form.check_box :notification %>
  </div>

  <div class="field">
    <%= todo_list_form.label :freq %>
    <%= todo_list_form.select :freq, TodoList.freqs.keys, {}, class: 'todolist-freqs-select' %>
  </div>

  <div class="field">
    <%= todo_list_form.label :completed %>
    <%= todo_list_form.check_box :completed %>
  </div>

  <div class="field">
    <%= todo_list_form.label :archived %>
    <%= todo_list_form.check_box :archived %>
  </div>

  <%= link_to_add_nested(todo_list_form, :todo_items, '#todo-items') %>

  <div id='todo-items'>
    <%= todo_list_form.fields_for :todo_items do |todo_item_form| %>
      <%= render "todo_item_fields", form: todo_item_form  %>
    <% end %>
  </div>

  <%= todo_list_form.submit %>
<% end %>
